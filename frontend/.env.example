VITE_WC_PROJECT_ID=your_walletconnect_project_id
# RPC URL used by wagmi for all chains (required). Must match where your contracts are deployed.
# Local Anvil (for balance/LP reads to match cast --rpc-url): http://127.0.0.1:8545 or http://localhost:8545
# Base Sepolia: https://base-sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Sepolia: https://rpc.sepolia.org
VITE_RPC_URL=

# Bonding curve dapp (optional – can also set in UI)
VITE_ROLLUP_RPC_URL=http://127.0.0.1:6751/rpc
VITE_DAPP_ADDRESS=
# Cartesi ERC20 Portal (required for deposit; must match backend ERC20_PORTAL_ADDRESS)
# VITE_ERC20_PORTAL_ADDRESS=
# Cartesi InputBox (required for withdraw)
# VITE_INPUT_BOX_ADDRESS=
# Vault contract (merged vault+adapter: one address for both vault and LP position reads)
# VITE_VAULT_ADDRESS=
# VITE_USDC_ADDRESS=

# Cartesi rollup GraphQL (for vouchers list/execute). Defaults to INSPECT_URL base + /graphql if unset.
# VITE_GRAPHQL_URL=http://localhost:8080/graphql
# Inspect base. v2: POST to base/inspect/<DAPP> with body JSON.stringify(route). Use /inspect-api to proxy (avoids CORS) or http://localhost:10012
# VITE_INSPECT_URL=/inspect-api
# VITE_INSPECT_URL=http://localhost:10012
# Optional: for "Due for execution" estimate in Vouchers popup (epoch length in blocks, block time in seconds).
# e.g. cartesi run --epoch-length=10 and default block time 1s: VITE_EPOCH_LENGTH=10 VITE_BLOCK_TIME_SEC=1
# VITE_EPOCH_LENGTH=
# VITE_BLOCK_TIME_SEC=
